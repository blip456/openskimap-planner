{
  // Vitest tests (Node APIs allowed) + the app sources they import. Checked by a second svelte-check run.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["vite/client", "node"]
  },
  "include": ["src/**/*.ts", "src/**/*.svelte", "test/**/*.ts"],
  "exclude": ["src/workers/**"]
}
